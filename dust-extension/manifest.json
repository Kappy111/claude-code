{
  "manifest_version": 3,
  "name": "Dust — inbox & storage sweeper",
  "version": "1.0",
  "description": "Sweep old junk emails to Trash and delete old downloads, to free up space.",
  "permissions": ["downloads", "tabs", "scripting"],
  "host_permissions": ["https://mail.google.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Dust" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
