{
  "manifest_version": 3,
  "name": "The1Min",
  "version": "0.1.0",
  "description": "Stuck for a minute? The1Min reads your screen and shows the best way to get unstuck.",
  "action": {
    "default_popup": "panel.html",
    "default_title": "The1Min — get unstuck"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "tabs", "storage", "idle", "notifications"],
  "host_permissions": ["https://api.anthropic.com/*", "<all_urls>"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Space", "mac": "Command+Shift+Space" },
      "description": "Open The1Min"
    }
  }
}
